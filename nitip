<!-- 1. LANDING SCREEN -->
    <div id="landing-screen" class="flex-1 flex items-center justify-center p-4 transition-opacity duration-500">
        <div class="bg-white p-8 md:p-12 rounded-3xl shadow-xl max-w-md w-full text-center border-4 border-blue-200 relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-yellow-300 rounded-full opacity-50 z-0"></div>
            <div class="relative z-10">
                <h1 class="text-4xl font-bold text-blue-600 mb-2">Latihan Numerasi</h1>
                <p class="text-gray-500 mb-8 font-semibold">Mari berhitung sambil bermain! 🚀</p>
                
                <!-- Pilihan Paket Soal -->
                <div class="mb-4 text-left">
                    <label class="block text-lg font-bold text-gray-700 mb-2">Pilih Paket Latihan</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button id="btn-paket-1" onclick="selectPackage('paket1')" class="paket-btn border-4 border-gray-200 text-gray-600 font-bold py-3 rounded-2xl hover:border-blue-400 hover:bg-blue-50 transition-all">Paket 1</button>
                        <button id="btn-paket-2" onclick="selectPackage('paket2')" class="paket-btn border-4 border-gray-200 text-gray-600 font-bold py-3 rounded-2xl hover:border-blue-400 hover:bg-blue-50 transition-all">Paket 2</button>
                    </div>
                    <p id="error-paket" class="text-red-500 font-semibold mt-2 hidden text-sm">Pilih paketnya dulu ya! 📦</p>
                </div>

                <div class="mb-6 text-left">
                    <label for="student-name" class="block text-lg font-bold text-gray-700 mb-2">Siapa namamu?</label>
                    <input type="text" id="student-name" placeholder="Tulis namamu di sini..." 
                        class="w-full px-5 py-4 text-lg border-2 border-blue-300 rounded-2xl focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition-all">
                    <p id="error-name" class="text-red-500 font-semibold mt-2 hidden text-sm">Namanya jangan lupa diisi ya! ✍️</p>
                </div>
                
                <button onclick="startQuiz()" 
                    class="w-full bg-green-500 hover:bg-green-600 text-white font-bold text-xl py-4 px-8 rounded-2xl shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all">
